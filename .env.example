# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings → API). Nunca versione o .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-ou-publishable
# Somente servidor: convite de usuários e scripts de seed. NUNCA use prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role
# URL pública do sistema (usada nos links dos e-mails de convite)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Área dos Diretores Comerciais (Manter / Mudar / Treinar): oculta por padrão. Para liberar: true
# ENABLE_DIRECTORS=true
